{
  "name": "simcore",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "make setup && cd frontend && npm ci --no-audit --no-fund && npm run build",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "simcore app", "onAutoForward": "openBrowser" } },
  "containerEnv": {
    "SIMCORE_EXAMPLES": "${containerWorkspaceFolder}/examples",
    "SIMCORE_FRONTEND": "${containerWorkspaceFolder}/frontend/dist"
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff"] }
  }
}
