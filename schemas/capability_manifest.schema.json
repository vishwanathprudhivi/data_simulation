{
  "$defs": {
    "DimensionDef": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source column; defaults to id.",
          "title": "Column"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "categorical",
          "enum": [
            "time_bucket",
            "categorical",
            "factor",
            "replication"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hierarchy parent dimension.",
          "title": "Parent"
        }
      },
      "required": [
        "id",
        "display_name"
      ],
      "title": "DimensionDef",
      "type": "object"
    },
    "EnvelopeBound": {
      "additionalProperties": false,
      "description": "Calibrated envelope bound for one lever (FR-SCG-09, FR-DOM-06).",
      "properties": {
        "lever": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
          "title": "Lever",
          "type": "string"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        }
      },
      "required": [
        "lever"
      ],
      "title": "EnvelopeBound",
      "type": "object"
    },
    "LeverDef": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "items": {},
          "title": "Choices",
          "type": "array"
        },
        "default": {
          "default": null,
          "title": "Default"
        },
        "depends_on": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "path": {
          "description": "Scenario path the lever sets, e.g. 'fleet.server.count'.",
          "title": "Path",
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "type": {
          "enum": [
            "int",
            "float",
            "bool",
            "enum",
            "duration",
            "distribution"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "id",
        "display_name",
        "path",
        "type"
      ],
      "title": "LeverDef",
      "type": "object"
    },
    "MetricDef": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "default": "mean",
          "enum": [
            "mean",
            "sum",
            "ratio_of_means",
            "p50",
            "p90",
            "p99",
            "min",
            "max"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "allowed_dimensions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Dimensions",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "direction": {
          "default": "neutral",
          "enum": [
            "higher_is_better",
            "lower_is_better",
            "neutral"
          ],
          "title": "Direction",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/NumberFormat"
        },
        "formula": {
          "description": "KPI key, or governed expression over event-log columns.",
          "title": "Formula",
          "type": "string"
        },
        "grain": {
          "default": "replication",
          "enum": [
            "replication",
            "task",
            "agent",
            "time_bucket"
          ],
          "title": "Grain",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "default": "kpi",
          "enum": [
            "kpi",
            "event_log"
          ],
          "title": "Source",
          "type": "string"
        },
        "statistical_treatment": {
          "default": "replication_mean_ci",
          "enum": [
            "replication_mean_ci",
            "ratio_of_means",
            "none"
          ],
          "title": "Statistical Treatment",
          "type": "string"
        },
        "unit": {
          "description": "SI unit symbol or '1' for dimensionless.",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display_name",
        "unit",
        "formula"
      ],
      "title": "MetricDef",
      "type": "object"
    },
    "NumberFormat": {
      "additionalProperties": false,
      "properties": {
        "decimals": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        },
        "kind": {
          "default": "number",
          "enum": [
            "number",
            "percent",
            "duration",
            "integer"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "NumberFormat",
      "type": "object"
    }
  },
  "$id": "urn:simcore:schema:capability_manifest:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Everything a domain lets users change, measure and slice (FR-DOM-03).",
  "properties": {
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/DimensionDef"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "disruption_types": {
      "items": {
        "type": "string"
      },
      "title": "Disruption Types",
      "type": "array"
    },
    "domain": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
      "title": "Domain",
      "type": "string"
    },
    "domain_version": {
      "title": "Domain Version",
      "type": "string"
    },
    "entity_types": {
      "items": {
        "type": "string"
      },
      "title": "Entity Types",
      "type": "array"
    },
    "envelope": {
      "items": {
        "$ref": "#/$defs/EnvelopeBound"
      },
      "title": "Envelope",
      "type": "array"
    },
    "levers": {
      "items": {
        "$ref": "#/$defs/LeverDef"
      },
      "title": "Levers",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricDef"
      },
      "title": "Metrics",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "policies": {
      "items": {
        "type": "string"
      },
      "title": "Policies",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tier": {
      "enum": [
        0,
        1,
        2
      ],
      "title": "Tier",
      "type": "integer"
    }
  },
  "required": [
    "domain",
    "domain_version",
    "tier",
    "name",
    "levers",
    "metrics",
    "dimensions",
    "policies",
    "disruption_types",
    "entity_types"
  ],
  "title": "CapabilityManifest",
  "type": "object",
  "x-schema-version": "1.0"
}
