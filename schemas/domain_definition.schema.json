    "LognormalDist": {
      "additionalProperties": false,
      "description": "Lognormal with ``mu``/``sigma`` of the underlying normal (natural log).",
      "properties": {
        "kind": {
          "const": "lognormal",
          "default": "lognormal",
          "title": "Kind",
          "type": "string"
        },
        "mu": {
          "title": "Mu",
          "type": "number"
        },
        "sigma": {
          "exclusiveMinimum": 0,
          "title": "Sigma",
          "type": "number"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
