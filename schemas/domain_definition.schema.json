              "type": "null"
            }
          ],
          "default": null,
          "description": "Hierarchy parent dimension.",
          "title": "Parent"
        }
      },
      "required": [
        "id",
        "display_name"
      ],
      "title": "DimensionDef",
      "type": "object"
    },
    "EmpiricalDist": {
      "additionalProperties": false,
      "description": "Resample from observed values (optionally weighted).",
