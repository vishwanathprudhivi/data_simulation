      "type": "object"
    },
    "MetricDef": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "default": "mean",
          "enum": [
            "mean",
            "sum",
            "ratio_of_means",
            "p50",
            "p90",
            "p99",
            "min",
            "max"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "allowed_dimensions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Dimensions",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "direction": {
          "default": "neutral",
          "enum": [
            "higher_is_better",
            "lower_is_better",
            "neutral"
          ],
          "title": "Direction",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/NumberFormat"
        },
        "formula": {
          "description": "KPI key, or governed expression over event-log columns.",
          "title": "Formula",
          "type": "string"
        },
        "grain": {
          "default": "replication",
          "enum": [
            "replication",
            "task",
            "agent",
            "time_bucket"
          ],
          "title": "Grain",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "default": "kpi",
          "enum": [
            "kpi",
            "event_log"
          ],
          "title": "Source",
          "type": "string"
        },
        "statistical_treatment": {
          "default": "replication_mean_ci",
          "enum": [
            "replication_mean_ci",
            "ratio_of_means",
            "none"
          ],
          "title": "Statistical Treatment",
          "type": "string"
        },
        "unit": {
          "description": "SI unit symbol or '1' for dimensionless.",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display_name",
        "unit",
        "formula"
      ],
      "title": "MetricDef",
      "type": "object"
    },
    "NormalDist": {
      "additionalProperties": false,
      "description": "Normal, optionally truncated below at ``min`` by resampling.",
