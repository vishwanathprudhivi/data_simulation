        "steps"
      ],
      "title": "RoutingDef",
      "type": "object"
    },
    "StationDef": {
      "additionalProperties": false,
      "description": "Tier-0 ``process_network`` station.",
      "properties": {
        "batch_size": {
          "default": 1,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "buffer_capacity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Buffer Capacity"
        },
        "capacity": {
          "default": 1,
          "minimum": 1,
          "title": "Capacity",
          "type": "integer"
        },
        "changeover": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*[A-Za-z/0-9]*\\s*$",
                  "type": "string"
                }
              ],
              "description": "time quantity: SI number or string with unit, e.g. '30 min'"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changeover"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "resource_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Type"
        },
        "service_time": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "constant": "#/$defs/ConstantDist",
                  "empirical": "#/$defs/EmpiricalDist",
                  "exponential": "#/$defs/ExponentialDist",
                  "gamma": "#/$defs/GammaDist",
                  "lognormal": "#/$defs/LognormalDist",
                  "normal": "#/$defs/NormalDist",
                  "triangular": "#/$defs/TriangularDist",
                  "uniform": "#/$defs/UniformDist",
                  "weibull": "#/$defs/WeibullDist"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ConstantDist"
                },
                {
                  "$ref": "#/$defs/ExponentialDist"
                },
                {
                  "$ref": "#/$defs/LognormalDist"
                },
                {
                  "$ref": "#/$defs/GammaDist"
                },
                {
                  "$ref": "#/$defs/WeibullDist"
                },
                {
                  "$ref": "#/$defs/NormalDist"
                },
                {
                  "$ref": "#/$defs/UniformDist"
                },
                {
                  "$ref": "#/$defs/TriangularDist"
                },
                {
                  "$ref": "#/$defs/EmpiricalDist"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Time"
        }
      },
      "required": [
        "id"
      ],
      "title": "StationDef",
      "type": "object"
    },
