    "ConstantDist": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "constant",
          "default": "constant",
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit of location/scale parameters; converted to SI at load, then cleared.",
          "title": "Unit"
