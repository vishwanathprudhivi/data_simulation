{
  "$defs": {
    "AgentPlan": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "sequence": {
          "items": {
            "$ref": "#/$defs/PlannedTask"
          },
          "title": "Sequence",
          "type": "array"
        }
      },
      "required": [
        "agent"
      ],
      "title": "AgentPlan",
      "type": "object"
    },
    "PlannedTask": {
      "additionalProperties": false,
      "properties": {
        "planned_finish": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*[A-Za-z/0-9]*\\s*$",
                  "type": "string"
                }
              ],
              "description": "time quantity: SI number or string with unit, e.g. '30 min'"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Finish"
        },
        "planned_start": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*[A-Za-z/0-9]*\\s*$",
                  "type": "string"
                }
              ],
              "description": "time quantity: SI number or string with unit, e.g. '30 min'"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Planned assignment time (s); used for deviation KPIs.",
          "title": "Planned Start"
        },
        "task": {
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "task"
      ],
      "title": "PlannedTask",
      "type": "object"
    }
  },
  "$id": "urn:simcore:schema:plan:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agents": {
      "items": {
        "$ref": "#/$defs/AgentPlan"
      },
      "title": "Agents",
      "type": "array"
    },
    "expected_kpis": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "KPIs the planner expects; compared after the run.",
      "title": "Expected Kpis",
      "type": "object"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "default": "external",
      "description": "Who produced the plan.",
      "title": "Source",
      "type": "string"
    },
    "unplanned": {
      "default": "fifo",
      "description": "Policy for tasks/agents not in the plan ('none' = leave them idle).",
      "title": "Unplanned",
      "type": "string"
    }
  },
  "required": [
    "id"
  ],
  "title": "PlanSpec",
  "type": "object",
  "x-schema-version": "1.0"
}
