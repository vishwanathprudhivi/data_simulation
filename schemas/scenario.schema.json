      "default": null,
      "title": "Domain Version"
    },
    "duration": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*[A-Za-z/0-9]*\\s*$",
          "type": "string"
        }
      ],
