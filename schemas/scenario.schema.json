      "title": "Extends"
    },
    "facility": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Path to facility.yaml.",
      "title": "Facility"
    },
    "fleet": {
      "items": {
        "$ref": "#/$defs/FleetEntry"
      },
      "title": "Fleet",
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
      "title": "Id",
      "type": "string"
    },
    "interaction": {
      "$ref": "#/$defs/InteractionSpec"
