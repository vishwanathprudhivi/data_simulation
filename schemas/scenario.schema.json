{
  "$defs": {
    "BeatSpec": {
      "additionalProperties": false,
      "description": "Scripted demo beat (FR-SCN-06).\n\nBeats only act in interactive sessions: they narrate, pause, change the playback\nspeed or inject disruptions live. Batch runs ignore them; an interactive session\ncan export the scenario with its injections as scheduled disruptions.",
      "properties": {
        "at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*[A-Za-z/0-9]*\\s*$",
              "type": "string"
            }
          ],
          "description": "time quantity: SI number or string with unit, e.g. '30 min'",
          "title": "At"
        },
        "inject": {
          "items": {
            "$ref": "#/$defs/InjectSpec"
          },
          "title": "Inject",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "narration": {
          "default": "",
          "title": "Narration",
          "type": "string"
        },
        "pause": {
          "default": false,
          "title": "Pause",
          "type": "boolean"
        },
        "speed": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sim seconds per wall second.",
          "title": "Speed"
        }
      },
      "required": [
        "name",
        "at"
      ],
      "title": "BeatSpec",
      "type": "object"
    },
    "ColocationSpec": {
      "additionalProperties": false,
      "description": "Service-time penalty when several agents work the same group (FR-INT-04).",
      "properties": {
        "group_attribute": {
          "default": "colocation_group",
          "description": "Location attribute naming the co-location group; defaults to the location.",
          "title": "Group Attribute",
          "type": "string"
        },
        "penalty_per_agent": {
          "default": 0.0,
          "description": "Service time x (1 + penalty x other agents in group).",
          "minimum": 0,
          "title": "Penalty Per Agent",
          "type": "number"
        }
      },
      "title": "ColocationSpec",
      "type": "object"
    },
    "ConstantDist": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "constant",
          "default": "constant",
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit of location/scale parameters; converted to SI at load, then cleared.",
          "title": "Unit"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "ConstantDist",
      "type": "object"
    },
    "DeadlockSpec": {
      "additionalProperties": false,
      "description": "Deadlock resolution (FR-INT-07).",
      "properties": {
        "strategy": {
          "default": "priority_yield",
          "enum": [
            "priority_yield",
            "reroute",
            "timeout",
            "none"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*[A-Za-z/0-9]*\\s*$",
              "type": "string"
            }
          ],
          "default": 30.0,
          "description": "Wait before yielding ('timeout').",
          "title": "Timeout"
        }
      },
      "title": "DeadlockSpec",
      "type": "object"
    },
    "DisruptionSpec": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*[A-Za-z/0-9]*\\s*$",
                  "type": "string"
                }
              ],
              "description": "time quantity: SI number or string with unit, e.g. '30 min'"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sim-time start (seconds).",
          "title": "At"
        },
        "duration": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*[A-Za-z/0-9]*\\s*$",
                  "type": "string"
                }
              ],
              "description": "time quantity: SI number or string with unit, e.g. '30 min'"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = until end of run.",
          "title": "Duration"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Entity id, 'type:<entity type>' or 'tag:<tag>' selecting affected entities.",
          "title": "Target"
        },
        "trigger": {
          "anyOf": [
            {
              "$ref": "#/$defs/TriggerSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "description": "Core type (see CORE_DISRUPTION_TYPES) or a domain type.",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "DisruptionSpec",
      "type": "object"
    },
    "EmpiricalDist": {
      "additionalProperties": false,
      "description": "Resample from observed values (optionally weighted).",
      "properties": {
        "kind": {
          "const": "empirical",
          "default": "empirical",
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit of location/scale parameters; converted to SI at load, then cleared.",
          "title": "Unit"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "weights": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights"
        }
      },
      "required": [
        "values"
      ],
      "title": "EmpiricalDist",
      "type": "object"
    },
    "ExponentialDist": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "exponential",
          "default": "exponential",
          "title": "Kind",
          "type": "string"
        },
        "mean": {
          "exclusiveMinimum": 0,
          "title": "Mean",
          "type": "number"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit of location/scale parameters; converted to SI at load, then cleared.",
          "title": "Unit"
        }
      },
      "required": [
        "mean"
      ],
      "title": "ExponentialDist",
      "type": "object"
    },
    "FleetEntry": {
      "additionalProperties": false,
      "properties": {
        "agent_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
          "title": "Agent Type",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "agent_type",
        "count"
      ],
      "title": "FleetEntry",
      "type": "object"
    },
    "GammaDist": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "gamma",
          "default": "gamma",
          "title": "Kind",
          "type": "string"
        },
        "scale": {
          "exclusiveMinimum": 0,
          "title": "Scale",
          "type": "number"
        },
        "shape": {
          "exclusiveMinimum": 0,
          "title": "Shape",
          "type": "number"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit of location/scale parameters; converted to SI at load, then cleared.",
          "title": "Unit"
        }
      },
      "required": [
        "shape",
        "scale"
      ],
      "title": "GammaDist",
      "type": "object"
    },
    "InjectSpec": {
      "additionalProperties": false,
      "description": "A disruption injected live by a demo beat or the operator (FR-IFC-05).",
      "properties": {
        "duration": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*[A-Za-z/0-9]*\\s*$",
                  "type": "string"
                }
              ],
              "description": "time quantity: SI number or string with unit, e.g. '30 min'"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "InjectSpec",
      "type": "object"
    },
    "InteractionSpec": {
      "additionalProperties": false,
      "description": "Parameters of the geometry-derived interaction model (FR-INT-02/05).\n\nAll are calibratable (``simcore.experiment.calibration``).",
      "properties": {
        "clearance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*[A-Za-z/0-9]*\\s*$",
              "type": "string"
            }
          ],
          "default": 0.2,
          "description": "Lateral gap needed between agents (m).",
          "title": "Clearance"
        },
        "colocation": {
          "$ref": "#/$defs/ColocationSpec"
        },
        "deadlock": {
          "$ref": "#/$defs/DeadlockSpec"
        },
        "density_alpha": {
          "default": 0.5,
          "description": "Speed loss per unit of edge width occupied by others.",
          "minimum": 0,
          "title": "Density Alpha",
          "type": "number"
        },
        "headway": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*[A-Za-z/0-9]*\\s*$",
                  "type": "string"
                }
              ],
              "description": "time quantity: SI number or string with unit, e.g. '30 min'"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum exit gap behind a leader in one lane; default footprint/speed.",
          "title": "Headway"
        },
        "min_speed_factor": {
          "default": 0.2,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Speed Factor",
          "type": "number"
        },
        "model": {
          "default": "geometric",
          "title": "Model",
          "type": "string"
        },
        "passing_speed_factor": {
          "default": 0.6,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Passing Speed Factor",
          "type": "number"
        }
      },
      "title": "InteractionSpec",
      "type": "object"
    },
    "ListDemand": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "list",
          "default": "list",
          "title": "Kind",
          "type": "string"
        },
        "stream": {
          "default": "demand",
          "description": "Named RNG stream for this source.",
          "title": "Stream",
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskSpec"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "title": "ListDemand",
      "type": "object"
    },
    "LognormalDist": {
      "additionalProperties": false,
      "description": "Lognormal with ``mu``/``sigma`` of the underlying normal (natural log).",
      "properties": {
        "kind": {
          "const": "lognormal",
          "default": "lognormal",
          "title": "Kind",
          "type": "string"
        },
        "mu": {
          "title": "Mu",
          "type": "number"
        },
        "sigma": {
          "exclusiveMinimum": 0,
          "title": "Sigma",
          "type": "number"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit of location/scale parameters; converted to SI at load, then cleared.",
          "title": "Unit"
        }
      },
      "required": [
        "mu",
        "sigma"
      ],
      "title": "LognormalDist",
      "type": "object"
    },
    "NormalDist": {
      "additionalProperties": false,
      "description": "Normal, optionally truncated below at ``min`` by resampling.",
      "properties": {
        "kind": {
          "const": "normal",
          "default": "normal",
          "title": "Kind",
          "type": "string"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "sd": {
          "exclusiveMinimum": 0,
          "title": "Sd",
          "type": "number"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit of location/scale parameters; converted to SI at load, then cleared.",
          "title": "Unit"
        }
      },
      "required": [
        "mean",
        "sd"
      ],
      "title": "NormalDist",
      "type": "object"
    },
    "PolicyRef": {
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "default": "pull",
          "description": "pull: idle agents request work; push: dispatcher assigns.",
          "enum": [
            "pull",
            "push"
          ],
          "title": "Assignment",
          "type": "string"
        },
        "name": {
          "default": "fifo",
          "title": "Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "title": "PolicyRef",
      "type": "object"
    },
    "ReplayDemand": {
      "additionalProperties": false,
      "description": "Replay of a historical CSV (columns per ``columns`` mapping, times in seconds).",
      "properties": {
        "columns": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map task field -> CSV column; defaults to identical names.",
          "title": "Columns",
          "type": "object"
        },
        "kind": {
          "const": "replay",
          "default": "replay",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "stream": {
          "default": "demand",
          "description": "Named RNG stream for this source.",
          "title": "Stream",
          "type": "string"
        },
        "time_offset": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*[A-Za-z/0-9]*\\s*$",
              "type": "string"
            }
          ],
          "default": 0.0,
          "description": "time quantity: SI number or string with unit, e.g. '30 min'",
          "title": "Time Offset"
        }
      },
      "required": [
        "path"
      ],
      "title": "ReplayDemand",
      "type": "object"
    },
    "StochasticDemand": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "destinations": {
          "items": {
            "type": "string"
          },
          "title": "Destinations",
          "type": "array"
        },
        "due_after": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "constant": "#/$defs/ConstantDist",
                  "empirical": "#/$defs/EmpiricalDist",
                  "exponential": "#/$defs/ExponentialDist",
                  "gamma": "#/$defs/GammaDist",
                  "lognormal": "#/$defs/LognormalDist",
                  "normal": "#/$defs/NormalDist",
                  "triangular": "#/$defs/TriangularDist",
                  "uniform": "#/$defs/UniformDist",
                  "weibull": "#/$defs/WeibullDist"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ConstantDist"
                },
                {
                  "$ref": "#/$defs/ExponentialDist"
                },
                {
                  "$ref": "#/$defs/LognormalDist"
                },
                {
                  "$ref": "#/$defs/GammaDist"
                },
                {
                  "$ref": "#/$defs/WeibullDist"
                },
                {
                  "$ref": "#/$defs/NormalDist"
                },
                {
                  "$ref": "#/$defs/UniformDist"
                },
                {
                  "$ref": "#/$defs/TriangularDist"
                },
                {
                  "$ref": "#/$defs/EmpiricalDist"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Due time = release + draw (seconds).",
          "title": "Due After"
        },
        "interarrival": {
          "discriminator": {
            "mapping": {
              "constant": "#/$defs/ConstantDist",
              "empirical": "#/$defs/EmpiricalDist",
              "exponential": "#/$defs/ExponentialDist",
              "gamma": "#/$defs/GammaDist",
              "lognormal": "#/$defs/LognormalDist",
              "normal": "#/$defs/NormalDist",
              "triangular": "#/$defs/TriangularDist",
              "uniform": "#/$defs/UniformDist",
              "weibull": "#/$defs/WeibullDist"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ConstantDist"
            },
            {
              "$ref": "#/$defs/ExponentialDist"
            },
            {
              "$ref": "#/$defs/LognormalDist"
            },
            {
              "$ref": "#/$defs/GammaDist"
            },
            {
              "$ref": "#/$defs/WeibullDist"
            },
            {
              "$ref": "#/$defs/NormalDist"
            },
            {
              "$ref": "#/$defs/UniformDist"
            },
            {
              "$ref": "#/$defs/TriangularDist"
            },
            {
              "$ref": "#/$defs/EmpiricalDist"
            }
          ],
          "title": "Interarrival"
        },
        "kind": {
          "const": "stochastic",
          "default": "stochastic",
          "title": "Kind",
          "type": "string"
        },
        "max_tasks": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tasks"
        },
        "origins": {
          "description": "Uniform choice if non-empty.",
          "items": {
            "type": "string"
          },
          "title": "Origins",
          "type": "array"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        },
        "quantity": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "constant": "#/$defs/ConstantDist",
                  "empirical": "#/$defs/EmpiricalDist",
                  "exponential": "#/$defs/ExponentialDist",
                  "gamma": "#/$defs/GammaDist",
                  "lognormal": "#/$defs/LognormalDist",
                  "normal": "#/$defs/NormalDist",
                  "triangular": "#/$defs/TriangularDist",
                  "uniform": "#/$defs/UniformDist",
                  "weibull": "#/$defs/WeibullDist"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ConstantDist"
                },
                {
                  "$ref": "#/$defs/ExponentialDist"
                },
                {
                  "$ref": "#/$defs/LognormalDist"
                },
                {
                  "$ref": "#/$defs/GammaDist"
                },
                {
                  "$ref": "#/$defs/WeibullDist"
                },
                {
                  "$ref": "#/$defs/NormalDist"
                },
                {
                  "$ref": "#/$defs/UniformDist"
                },
                {
                  "$ref": "#/$defs/TriangularDist"
                },
                {
                  "$ref": "#/$defs/EmpiricalDist"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*[A-Za-z/0-9]*\\s*$",
              "type": "string"
            }
          ],
          "default": 0.0,
          "description": "time quantity: SI number or string with unit, e.g. '30 min'",
          "title": "Start"
        },
        "stop": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
