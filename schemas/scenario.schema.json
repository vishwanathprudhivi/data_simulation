      "title": "Behaviors"
    },
    "demand": {
      "items": {
        "discriminator": {
          "mapping": {
            "list": "#/$defs/ListDemand",
            "replay": "#/$defs/ReplayDemand",
            "stochastic": "#/$defs/StochasticDemand"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/StochasticDemand"
          },
          {
            "$ref": "#/$defs/ReplayDemand"
          },
          {
            "$ref": "#/$defs/ListDemand"
          }
        ]
      },
      "title": "Demand",
      "type": "array"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "disruptions": {
